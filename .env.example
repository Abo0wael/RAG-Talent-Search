# =============================================================================
# RAG Talent Search Engine - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- LLM Provider Configuration ---
# Supported providers: groq, openai, google
LLM_PROVIDER=groq

# Groq API Key (Primary - get from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Alternative - get from https://platform.openai.com/)
# OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Alternative - get from https://makersuite.google.com/)
# GOOGLE_API_KEY=your_google_api_key_here
